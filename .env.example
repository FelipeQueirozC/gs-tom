# Shared secrets come from /etc/collector-env/common.env:
# RESEND_API_KEY
# OPENCODE_API_KEY
# TELEGRAM_BOT_TOKEN
# TELEGRAM_ERROR_CHAT_ID

RESEND_FROM=GS Top of Mind <reports@example.com>
RESEND_TO=recipient@example.com

# Optional overrides. Dynamic model selection is the default.
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_SUMMARIZER_MODEL=latest-deepseek-pro
